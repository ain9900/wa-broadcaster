# Copy to .env (or run `node scripts/setup.mjs`, which fills in random secrets for you).
# One file configures every part: Django, Celery, the WhatsApp gateway and Docker Compose.

# ---------- Django ----------
# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# false for Docker and any VPS. true only for `npm run dev` on your own computer.
DJANGO_DEBUG=false
# Hostnames the site is served on (add your domain on the VPS).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins the browser uses (scheme + host + port).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# Set true once the site runs behind HTTPS.
DJANGO_SECURE=false
# Time zone for "today" (daily limits, charts) and scheduling. e.g. Asia/Dhaka, Europe/London
TIME_ZONE=Asia/Dhaka
# Largest attachment, in MB.
MAX_UPLOAD_MB=25

# Show "Create an account" on the sign-in page. Each new user gets their own empty workspace.
# Keep false on a public server unless you want anyone who finds the site to sign up.
ALLOW_SIGNUP=false

# First dashboard user, created automatically if no users exist yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password

# ---------- Database & queue ----------
# Docker Compose builds DATABASE_URL and REDIS_URL itself; you only set the Postgres password.
POSTGRES_PASSWORD=change-me
# Without Docker: leave both empty to use SQLite and the built-in worker (no Redis needed).
# DATABASE_URL=postgres://wab:password@127.0.0.1:5432/wab
# REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=
REDIS_URL=

# ---------- WhatsApp connection ----------
# builtin   = the bundled Node/Baileys gateway (./gateway)
# evolution = Evolution API (start it with: docker compose --profile evolution up -d)
WA_PROVIDER=builtin

# Built-in gateway. The API key is shared between Django and the gateway.
GATEWAY_API_KEY=change-me
GATEWAY_URL=http://127.0.0.1:3100
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3100
GATEWAY_WEBHOOK_URL=http://127.0.0.1:8000/api/whatsapp/webhook/
# WhatsApp library log level: silent, error, warn, info, debug
WA_LOG_LEVEL=warn

# Evolution API (only when WA_PROVIDER=evolution)
EVOLUTION_API_KEY=change-me
EVOLUTION_URL=http://127.0.0.1:8080
# Where the WhatsApp provider sends events back to Django.
WEBHOOK_URL=http://127.0.0.1:8000/api/whatsapp/webhook/

# ---------- Docker Compose ----------
# Reverse proxies in front of Django (for real client IPs). Docker alone: 1. Docker + host Nginx on a VPS: 2.
NUM_PROXIES=1
# Port of the web UI. Keep 127.0.0.1 on a VPS and put Nginx/Caddy with HTTPS in front.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

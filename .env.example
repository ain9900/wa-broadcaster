# Copy this file to .env and change the values.

# Password for the dashboard. Use something long.
ADMIN_PASSWORD=change-me-to-a-long-password

# Random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-string

# Where the app listens. Keep 127.0.0.1 on the VPS so only Nginx can reach it.
HOST=127.0.0.1
PORT=3000

# Set to true once the site runs behind HTTPS (on the VPS with a domain).
COOKIE_SECURE=false

# Seconds to wait between groups by default (the dashboard can change it per send).
DEFAULT_DELAY_SECONDS=8

# WhatsApp library log level: silent, error, warn, info, debug
WA_LOG_LEVEL=warn
